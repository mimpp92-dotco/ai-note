# AI NOTE — local configuration. Copy to .env.local and adjust.
# Everything is local; no secrets/API keys are used.

# --- Whisper (local STT service) ---
# Model: large-v3 is best but multi-GB; use base/small for a fast first run.
LOCAL_STT_MODEL=large-v3
# Decode language: a Whisper language code (e.g. ko, en) or "auto" to detect.
LOCAL_STT_LANG=ko
# Silence/hallucination filter (VAD + no repeat-conditioning). On by default; set 0 to disable.
LOCAL_STT_VAD=1
# Service bind address (keep on 127.0.0.1 — never expose to the LAN).
LOCAL_STT_HOST=127.0.0.1
LOCAL_STT_PORT=8123
# Optional: MLX model repo override (Apple Silicon).
# LOCAL_STT_MLX_REPO=mlx-community/whisper-large-v3-mlx
# Optional: path to a glossary JSON (defaults to ./glossary.json).
# LOCAL_STT_GLOSSARY=./glossary.json

# --- ffmpeg ---
# Explicit ffmpeg binary if it's not on PATH.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# --- Test/dev stubs (leave unset in normal use) ---
# FAKE_WHISPER=1
# FAKE_FFMPEG=1
# FAKE_LLM=1
# Disable the background auto-summarize worker (e.g. for tests/CI).
# AI_NOTE_DISABLE_WORKER=1
