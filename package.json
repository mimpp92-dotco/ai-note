{
  "name": "ai-note",
  "version": "0.1.0",
  "description": "Local-first meeting recorder: record → local Whisper transcription → LLM summary via your own Claude/Codex CLI or Ollama. No cloud, no accounts, no API keys stored.",
  "license": "MIT",
  "author": "Dylan",
  "repository": {
    "type": "git",
    "url": "https://github.com/mimpp92-dotco/ai-note.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently \"next dev --turbopack\" \"uv run --project whisper python whisper/server.py\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "next": "^15.5.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.3",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
